# Fermata 环境变量样例。它只用于说明变量名和约束；Fermata 不会自动读取仓库根目录的 `.env`。
# 请由部署平台注入变量，或把填写后的内容放入 private/fermata.env（权限 0600）并用
# `node scripts/run-with-env.mjs "$PWD/private/fermata.env" npm start` 启动；.env 和该文件都不要提交。

# ---- Urmotiv 机器人 API（必填） ----

# Urmotiv 服务的基础地址，不能带账号、密码、? 后的查询内容或 # 后的片段，
# 比如 https://urmotiv.example.com
URMOTIV_BASE_URL=

# 机器人账号的 API 令牌（Authorization: Bearer <token>），由 Urmotiv 管理员创建机器人账号后签发
URMOTIV_ROBOT_TOKEN=

# ---- Fermata 自身管理端口（必填） ----

# Fermata 管理端口监听的端口号，默认 8720，可以不填
FERMATA_PORT=8720

# 管理端口的 Bearer 令牌，供 Urmotiv 的 fermata-control 插件调用；至少 16 个字符，建议用随机字符串
FERMATA_MANAGEMENT_TOKEN=

# 运行期设置（settings.json）存放路径，默认 ./data/settings.json，可以不填；
# 用 Docker 部署时建议挂载一个卷到这个路径所在目录，这样重启容器不会丢失设置
FERMATA_SETTINGS_PATH=./data/settings.json

# ---- 模型服务商（至少配置 config/models.yaml 里用到的那些，否则启动会失败） ----

# Aether 网关，OpenAI 兼容的 Chat Completions 接口，baseUrl 需要包含到 /v1 之类的前缀；
# 地址不能带账号、密码、? 后的查询内容或 # 后的片段，密钥只填在 AETHER_API_KEY
AETHER_BASE_URL=
AETHER_API_KEY=

# 阿里云百炼（DashScope）compatible-mode，baseUrl 通常是
# https://dashscope.aliyuncs.com/compatible-mode/v1（注意末尾是 /v1，不要漏）；
# 地址不能带账号、密码、? 后的查询内容或 # 后的片段，密钥只填在 DASHSCOPE_API_KEY
DASHSCOPE_BASE_URL=
DASHSCOPE_API_KEY=

# ---- Codeforces API（可选，只在跑 experiments/ 下的数据集脚本时用得到） ----

# 不配置也能匿名调用 problemset.problems 等公开方法，但更容易被限流；
# key/secret 从 Codeforces 个人设置页的 API 页面创建
CODEFORCES_KEY=
CODEFORCES_SECRET=
