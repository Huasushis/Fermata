{
  "name": "@fermata/service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fermata：USTC 算法竞赛协会的独立 AI 审题服务，轮询 Urmotiv 待审题目并提交结构化审核意见。",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "experiment:report-review-flow-stages": "tsx experiments/review-flow-stage-report.ts",
    "experiment:fetch-cf-dataset": "tsx experiments/fetch-cf-dataset.ts",
    "experiment:eval-difficulty": "tsx experiments/eval-difficulty.ts",
    "experiment:probe-difficulty-connectivity": "tsx experiments/probe-difficulty-connectivity.ts",
    "experiment:update-connectivity-code-version": "node scripts/update-eval-code-version.mjs",
    "experiment:probe-difficulty-thinking": "tsx experiments/probe-difficulty-thinking.ts",
    "experiment:probe-difficulty-pro": "tsx experiments/probe-difficulty-pro.ts",
    "experiment:calibrate-anchors": "tsx experiments/calibrate-anchors.ts",
    "experiment:fetch-hf-dataset": "tsx experiments/fetch-hf-dataset.ts",
    "experiment:calibrate-levels": "tsx experiments/calibrate-levels.ts",
    "experiment:calibrate-levels:detached": "node scripts/start-detached-calibration.mjs",
    "experiment:verify-legacy-reports": "node scripts/verify-legacy-report-registry.mjs",
    "experiment:eval-verdict": "tsx experiments/eval-verdict.ts",
    "experiment:eval-review-flow": "node scripts/review-flow-evaluation-bootstrap.mjs",
    "experiment:prepare-review-flow-dataset": "tsx experiments/prepare-review-flow-dataset.ts",
    "experiment:prepare-review-flow-historical-inputs": "tsx experiments/prepare-review-flow-historical-inputs.ts",
    "experiment:finalise-review-flow-bridge-plan": "tsx experiments/finalise-review-flow-bridge-plan.ts"
  },
  "dependencies": {
    "undici": "8.9.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "hyparquet": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
